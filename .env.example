# Copia este fichero a .env y rellena los valores.
# En una EC2 nueva, setup.sh genera el .env automáticamente.

# General
DEBUG=False
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_O_DOMINIO
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
APP_BUILD=
SITE_NAME=TopTrack
SITE_TAGLINE=FSC Top Nutrition
SUPPORT_EMAIL=info@fsctopnutrition.com
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Base de datos PostgreSQL (si DATABASE_URL está vacío, se usa SQLite)
DATABASE_URL=postgres://toptrack@localhost:5432/toptrack
DB_NAME=toptrack
DB_USER=toptrack
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email saliente (reset de contraseña e invitaciones). Si EMAIL_HOST queda
# vacío, Django usa el backend de consola y no envía nada (útil en local).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TopTrack <no-reply@fsctopnutrition.com>
